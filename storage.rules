rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to get user role from Firestore
    function getUserRole() {
      return firestore.get(/databases/ai-studio-184f647f-85c7-4de6-9412-282df12602e9/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isTeacher() {
      return isAuthenticated() && getUserRole() == 'teacher';
    }

    // Submissions: Students can upload their own, everyone authenticated can read
    match /submissions/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Projects: Teachers and Admins can upload assets, everyone authenticated can read
    match /projects/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isTeacher();
    }

    // Curriculum assets (modules, etc.)
    match /modules/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isTeacher();
    }

    // Curriculum assets (general)
    match /curriculum/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isTeacher();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

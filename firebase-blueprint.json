{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user with role-based access and gamification data.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "teacher", "student"] },
        "schoolIds": { "type": "array", "items": { "type": "string" } },
        "mode": { "type": "string", "enum": ["in-school", "online"] },
        "xp": { "type": "number", "default": 0 },
        "level": { "type": "number", "default": 1 },
        "badges": { "type": "array", "items": { "type": "string" } },
        "lastLogin": { "type": "string", "format": "date-time" },
        "projectPoints": { "type": "number", "default": 0 },
        "quizPoints": { "type": "number", "default": 0 },
        "totalPoints": { "type": "number", "default": 0 }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "School": {
      "title": "School",
      "description": "Educational institution mapped to the LMS.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "state": { "type": "string" }
      },
      "required": ["id", "name", "state"]
    },
    "Component": {
      "title": "Component",
      "description": "Reusable hardware or software component for projects.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Course": {
      "title": "Course",
      "description": "Robotics curriculum for specific grades.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "grade": { "type": "number", "description": "Class 1 to 12" },
        "description": { "type": "string" },
        "schoolId": { "type": "string" },
        "activated": { "type": "boolean" }
      },
      "required": ["id", "title", "grade"]
    },
    "Module": {
      "title": "Module",
      "description": "A specific learning module within a course.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "driveUrl": { "type": "string", "format": "uri" },
        "thumbnailUrl": { "type": "string" },
        "isVisible": { "type": "boolean", "default": true },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "url": { "type": "string" },
              "type": { "type": "string", "enum": ["video", "pdf", "ppt", "image", "link"] }
            }
          }
        },
        "componentIds": { "type": "array", "items": { "type": "string" } },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "content": { "type": "string" },
              "imageUrl": { "type": "string" }
            }
          }
        },
        "quizQuestions": {
          "type": "array",
          "items": {
            "$ref": "#/entities/QuizQuestion"
          }
        }
      },
      "required": ["id", "courseId", "title"]
    },
    "QuizQuestion": {
      "title": "QuizQuestion",
      "description": "Multiple choice mock test question.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "correctOptionIdx": { "type": "number" }
      },
      "required": ["id", "question", "options", "correctOptionIdx"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Student mock test scores and performance.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "moduleId": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "pointsEarned": { "type": "number" },
        "completed": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "studentId", "moduleId", "score", "totalQuestions", "pointsEarned", "completed", "timestamp"]
    },
    "ProjectTheme": {
      "title": "ProjectTheme",
      "description": "Monthly or quarterly project themes for student competitions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "month": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "stepsHtml": { "type": "string" },
        "rewardDescription": { "type": "string" }
      },
      "required": ["id", "title", "description", "month", "active", "createdAt"]
    },
    "ThematicSubmission": {
      "title": "ThematicSubmission",
      "description": "Approved or pending creative project submissions based on monthly themes.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "themeId": { "type": "string" },
        "themeTitle": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" },
        "classSection": { "type": "string" },
        "photoUrl": { "type": "string", "format": "uri" },
        "description": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "teacherFeedback": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "pointsAwarded": { "type": "number" }
      },
      "required": ["id", "themeId", "studentId", "photoUrl", "status", "timestamp"]
    },
    "ContentActivation": {
      "title": "ContentActivation",
      "description": "Tracks which modules are activated for a school/teacher.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "moduleId": { "type": "string" },
        "schoolId": { "type": "string" },
        "teacherId": { "type": "string" },
        "activated": { "type": "boolean" }
      },
      "required": ["moduleId", "schoolId", "teacherId", "activated"]
    },
    "Project": {
      "title": "Project",
      "description": "Robotics project assigned to students.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "moduleId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "driveUrl": { "type": "string", "format": "uri" },
        "thumbnailUrl": { "type": "string" },
        "isVisible": { "type": "boolean", "default": true },
        "projectImages": { "type": "array", "items": { "type": "string" } },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "url": { "type": "string" },
              "type": { "type": "string", "enum": ["video", "pdf", "ppt", "image", "link"] }
            }
          }
        },
        "componentIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "courseId", "moduleId", "title"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Student project submission with review data.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "studentId": { "type": "string" },
        "partnerIds": { "type": "array", "items": { "type": "string" } },
        "photoUrl": { "type": "string", "format": "uri" },
        "videoUrl": { "type": "string", "format": "uri" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "approved", "rejected"] },
        "rating": { "type": "number" },
        "feedback": { "type": "string" },
        "schoolId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "projectTitle": { "type": "string" }
      },
      "required": ["id", "projectId", "studentId", "timestamp", "status"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Student attendance record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "schoolId": { "type": "string" },
        "teacherId": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["present", "absent"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "schoolId", "teacherId", "date", "status", "timestamp"]
    },
    "Log": {
      "title": "Log",
      "description": "Classroom activity logs for teachers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "schoolId": { "type": "string" },
        "courseId": { "type": "string" },
        "moduleId": { "type": "string" },
        "date": { "type": "string" },
        "period": { "type": "string" },
        "classSection": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "duration": { "type": "number", "description": "Duration in minutes" },
        "activity": { "type": "string" }
      },
      "required": ["id", "teacherId", "schoolId", "timestamp", "activity"]
    },
    "ExpenseTemplate": {
      "title": "ExpenseTemplate",
      "description": "Pre-defined expense amount for a teacher visiting a school.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "schoolId": { "type": "string" },
        "totalAmount": { "type": "number" },
        "description": { "type": "string" },
        "legs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mode": { "type": "string", "enum": ["Auto", "Bus", "Train/Metro", "Bike", "Personal Vehicle", "Others"] },
              "amount": { "type": "number" }
            }
          }
        }
      },
      "required": ["id", "teacherId", "schoolId", "totalAmount"]
    },
    "ExpenseLog": {
      "title": "ExpenseLog",
      "description": "A trainer's travel expense record for a specific day.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" },
        "totalAmount": { "type": "number" },
        "legs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mode": { "type": "string", "enum": ["Auto", "Bus", "Train/Metro", "Bike", "Personal Vehicle", "Others"] },
              "amount": { "type": "number" }
            }
          }
        },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] }
      },
      "required": ["id", "teacherId", "schoolId", "totalAmount", "date", "status"]
    },
    "SimulationLab": {
      "title": "SimulationLab",
      "description": "Virtual robotics and IoT simulator challenge labs.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "microcontroller": { "type": "string", "enum": ["arduino-uno", "esp32", "pi-pico"] },
        "starterWokwiId": { "type": "string" },
        "testCriteria": { "type": "string" },
        "points": { "type": "number", "default": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "creatorId": { "type": "string" }
      },
      "required": ["id", "title", "description", "microcontroller", "points", "createdAt"]
    },
    "SimulationSubmission": {
      "title": "SimulationSubmission",
      "description": "Student Wokwi circuit simulation program code submissions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "labId": { "type": "string" },
        "labTitle": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" },
        "classSection": { "type": "string" },
        "wokwiUrl": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "teacherFeedback": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "pointsAwarded": { "type": "number" }
      },
      "required": ["id", "labId", "studentId", "wokwiUrl", "status", "timestamp"]
    },
    "ClassroomPhotoSubmission": {
      "title": "ClassroomPhotoSubmission",
      "description": "Media uploads from regular day-wise classroom teaching activities.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" },
        "grade": { "type": "string" },
        "section": { "type": "string" },
        "dayNumber": { "type": "number" },
        "lessonName": { "type": "string" },
        "lessonId": { "type": "string" },
        "driveUrls": { "type": "array", "items": { "type": "string" } },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "schoolId", "grade", "section", "lessonId", "driveUrls", "teacherId", "timestamp"]
    },
    "CompetitionProjectSubmission": {
      "title": "CompetitionProjectSubmission",
      "description": "Documentation for school-wide competition project submissions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" },
        "projectName": { "type": "string" },
        "competitionName": { "type": "string" },
        "studentNames": { "type": "array", "items": { "type": "string" } },
        "projectBrief": { "type": "string" },
        "photoDriveUrl": { "type": "string" },
        "pdfDriveUrl": { "type": "string" },
        "videoDriveUrl": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "schoolId", "projectName", "competitionName", "studentNames", "projectBrief", "photoDriveUrl", "pdfDriveUrl", "videoDriveUrl", "teacherId", "timestamp"]
    },
    "SchoolCurriculum": {
      "title": "SchoolCurriculum",
      "description": "Day-wise curriculums mapped to specific schools and grade levels.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" },
        "grade": { "type": "string" },
        "numberOfClasses": { "type": "number" },
        "selectedCourseIds": { "type": "array", "items": { "type": "string" } },
        "classes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "classNumber": { "type": "number" },
              "courseId": { "type": "string" },
              "courseTitle": { "type": "string" },
              "lessonId": { "type": "string" },
              "lessonTitle": { "type": "string" }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "schoolId", "schoolName", "grade", "numberOfClasses", "classes"]
    },
    "CurriculumProgress": {
      "title": "CurriculumProgress",
      "description": "Independently tracked lesson and step progress for every school, grade, and section combination.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "grade": { "type": "string" },
        "section": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "statuses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "classNumber": { "type": "number" },
              "courseId": { "type": "string" },
              "lessonId": { "type": "string" },
              "status": { "type": "string", "enum": ["Complete", "In Progress", "Not Started"] },
              "start_date": { "type": "string" },
              "end_date": { "type": "string" },
              "lastActiveStepIdx": { "type": "number" }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "schoolId", "grade", "section"]
    }
  },
  "firestore": {
    "/users/{uid}": { "schema": "User", "description": "User profiles." },
    "/schools/{schoolId}": { "schema": "School", "description": "School details." },
    "/courses/{courseId}": { "schema": "Course", "description": "Course information." },
    "/modules/{moduleId}": { "schema": "Module", "description": "Learning modules." },
    "/activations/{activationId}": { "schema": "ContentActivation", "description": "Module activations." },
    "/projects/{projectId}": { "schema": "Project", "description": "Project assignments." },
    "/submissions/{submissionId}": { "schema": "Submission", "description": "Student submissions." },
    "/attendance/{attendanceId}": { "schema": "Attendance", "description": "Attendance records." },
    "/logs/{logId}": { "schema": "Log", "description": "Teacher activity logs." },
    "/expenseTemplates/{templateId}": { "schema": "ExpenseTemplate", "description": "Expense templates." },
    "/expenseLogs/{expenseLogId}": { "schema": "ExpenseLog", "description": "Expense records." },
    "/projectThemes/{themeId}": { "schema": "ProjectTheme", "description": "Project theme topics." },
    "/thematicSubmissions/{submissionId}": { "schema": "ThematicSubmission", "description": "Student thematic submissions." },
    "/quizAttempts/{attemptId}": { "schema": "QuizAttempt", "description": "Student quiz attempts." },
    "/simulationLabs/{labId}": { "schema": "SimulationLab", "description": "Wokwi assignment challenge labs." },
    "/simulationSubmissions/{submissionId}": { "schema": "SimulationSubmission", "description": "Student Wokwi lab submissions." },
    "/classroomActivityPhotos/{submissionId}": { "schema": "ClassroomPhotoSubmission", "description": "Media uploads from regular day-wise classroom teaching activities." },
    "/competitionProjectPhotos/{submissionId}": { "schema": "CompetitionProjectSubmission", "description": "Documentation for school-wide competition project submissions." },
    "/schoolCurriculums/{curriculumId}": { "schema": "SchoolCurriculum", "description": "School curriculums mapped day-wise." },
    "/curriculumProgress/{progressId}": { "schema": "CurriculumProgress", "description": "Progress tracking for curriculums." }
  }
}
